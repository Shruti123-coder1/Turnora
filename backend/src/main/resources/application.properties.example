# ---------- Server ----------
spring.application.name=turnora
server.port=${PORT:8080}

# ---------- Database (PostgreSQL) ----------
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/turnora_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:YOUR_PASSWORD}

# ---------- JPA (tables are created automatically) ----------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=Asia/Kolkata

# ---------- JWT ----------
jwt.secret=${JWT_SECRET:CHANGE_THIS_TO_A_LONG_RANDOM_TEXT_OF_32_OR_MORE_CHARACTERS}
jwt.expiration-ms=86400000

# ---------- CORS (frontend address) ----------
app.cors.allowed-origins=${CORS_ORIGINS:http://localhost:5173}

# ---------- SMS (keep sms.enabled=false until you add a provider key) ----------
sms.enabled=${SMS_ENABLED:false}
sms.provider.url=${SMS_URL:PROVIDER_API_URL}
sms.provider.api-key=${SMS_API_KEY:YOUR_SMS_API_KEY}
sms.provider.sender=${SMS_SENDER:TURNORA}